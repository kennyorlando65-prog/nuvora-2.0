# ---------------------------------------------------------------------------
# NUVORA - environment variable placeholders.
#
# Copy to .env.local for local development. NEVER commit real values.
# Nothing in this file is a secret; it is a manifest of what must be set.
#
# WHERE EACH VALUE GOES IN PRODUCTION
#   Vercel  -> Project -> Settings -> Environment Variables   (serverless routes)
#   Supabase-> Project -> Settings -> Edge Functions -> Secrets (scheduled jobs)
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Publishable / safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>
# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# --- Site ---------------------------------------------------------------------
# Used for absolute URLs in emails and for the webhook return path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Salt for hashing customer IP addresses before they are stored for fraud review.
# Leave blank and NO IP is stored at all - the column is nullable, and an unsalted hash
# of a 32-bit address space is trivially reversible, so blank is safer than weak.
IP_HASH_SALT=<RANDOM_LONG_STRING>

# --- Payment gateway (Stage 6) ------------------------------------------------
# Choose the active gateway with PAYMENT_PROVIDER, then fill only that gateway.
# PAYMENT_PROVIDER=paystack | flutterwave | disabled
PAYMENT_PROVIDER=disabled

# Paystack - Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=<PAYSTACK_SECRET_KEY>
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<PAYSTACK_PUBLIC_KEY>

# Flutterwave - Dashboard -> Settings -> API Keys
FLUTTERWAVE_SECRET_KEY=<FLUTTERWAVE_SECRET_KEY>
FLUTTERWAVE_WEBHOOK_SECRET_HASH=<FLUTTERWAVE_WEBHOOK_SECRET_HASH>
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=<FLUTTERWAVE_PUBLIC_KEY>

# --- Provider adapter (Stage 5) -----------------------------------------------
# PROVIDER_MODE is THE switch for supplier traffic.
#   sandbox -> nothing leaves this process. Safe default.
#   live    -> real supplier calls. Also requires the ESIM_PROVIDER_* pair below.
# On a Vercel PRODUCTION deployment, sandbox REFUSES to run unless you explicitly
# set PROVIDER_ALLOW_SANDBOX_IN_PRODUCTION=true, so a live store can never silently
# sell simulated goods.
PROVIDER_MODE=sandbox

# eSIM supplier - set BOTH of these, then set PROVIDER_MODE=live, to go live.
ESIM_PROVIDER_BASE_URL=<ESIM_SUPPLIER_API_BASE_URL>
ESIM_PROVIDER_API_KEY=<ESIM_SUPPLIER_API_KEY>
# Optional: some suppliers want a second auth header. Name it here.
ESIM_PROVIDER_AUTH_HEADER=<OPTIONAL_EXTRA_AUTH_HEADER_NAME>

# --- Sandbox controls (ignored entirely when PROVIDER_MODE=live) ---------------
# Forces the outcome of every sandbox fulfilment so failure and pending paths are
# testable: completed | pending | failed. Leave blank for the normal success path.
PROVIDER_SANDBOX_OUTCOME=
# Optional simulated supplier cost in minor units, used only by sandbox quotes.
# It is NOT a catalogue price and is never written to the products table.
PROVIDER_SANDBOX_UNIT_COST_MINOR=
# Only set this to true to run sandbox on a production deployment ON PURPOSE
# (a demo or staging slot). Every fulfilment will be simulated.
PROVIDER_ALLOW_SANDBOX_IN_PRODUCTION=false

# --- Communications (transactional email) -------------------------------------
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM="NUVORA <no-reply@example.com>"
