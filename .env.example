# ---------------------------------------------------------------------------
# NUVORA - environment variable placeholders.
#
# Copy to .env.local for local development. NEVER commit real values.
# Nothing in this file is a secret; it is a manifest of what must be set.
#
# WHERE EACH VALUE GOES IN PRODUCTION
#   Vercel  -> Project -> Settings -> Environment Variables   (serverless routes)
#   Supabase-> Project -> Settings -> Edge Functions -> Secrets (scheduled jobs)
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Publishable / safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>
# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# --- Site ---------------------------------------------------------------------
# Used for absolute URLs in emails and for the webhook return path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment gateway (Stage 6) ------------------------------------------------
# Choose the active gateway with PAYMENT_PROVIDER, then fill only that gateway.
# PAYMENT_PROVIDER=paystack | flutterwave | disabled
PAYMENT_PROVIDER=disabled

# Paystack - Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=<PAYSTACK_SECRET_KEY>
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<PAYSTACK_PUBLIC_KEY>

# Flutterwave - Dashboard -> Settings -> API Keys
FLUTTERWAVE_SECRET_KEY=<FLUTTERWAVE_SECRET_KEY>
FLUTTERWAVE_WEBHOOK_SECRET_HASH=<FLUTTERWAVE_WEBHOOK_SECRET_HASH>
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=<FLUTTERWAVE_PUBLIC_KEY>

# --- Provider adapter (Stage 5) -----------------------------------------------
# PROVIDER_MODE=sandbox keeps every supplier call local and deterministic.
# PROVIDER_MODE=live is the ONLY thing that sends real traffic to a supplier.
PROVIDER_MODE=sandbox
PROVIDER_SANDBOX_SEED=nuvora-sandbox

# eSIM supplier - fill when you move this adapter to live.
ESIM_PROVIDER_BASE_URL=<ESIM_SUPPLIER_API_BASE_URL>
ESIM_PROVIDER_API_KEY=<ESIM_SUPPLIER_API_KEY>

# --- Communications (transactional email) -------------------------------------
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM="NUVORA <no-reply@example.com>"
